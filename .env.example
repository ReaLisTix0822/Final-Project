PORT=3000
NODE_ENV=development
# ใช้เซ็น token การเข้าสู่ระบบ ควรเปลี่ยนเป็นข้อความสุ่มยาว ๆ ของคุณเอง
JWT_SECRET=super_secret_jwt_inclusive_marketplace_key_2026

# MySQL Database Configuration
# กำหนดค่าเชื่อมต่อ MySQL หากเปิดใช้งาน MySQL Server ในเครื่อง (เช่น XAMPP)
# ถ้าเชื่อมต่อ MySQL ไม่ได้ ระบบจะใช้ SQLite (db/marketplace.sqlite) ให้อัตโนมัติ
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=inclusive_marketplace
DB_PORT=3306

# 1-click demo accounts on the login page (only when true)
DEMO_MODE=true

# Google Gemini (ไม่บังคับ): แชทบอทน้องใจดี, ช่วยเขียนเรื่องราวสินค้า, กรอกข้อมูลสินค้าจากรูป, คำบรรยายวิดีโอ
# ไม่ใส่ก็ได้ ระบบจะตอบด้วยคำตอบสำรองในเครื่องแทน  ขอคีย์ได้ที่ https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_CAPTION_MODEL=

# สร้างโมเดล 3D จากรูปสินค้า (ไม่บังคับ): ใช้ TRELLIS ผ่าน fal.ai หรือเซิร์ฟเวอร์ TRELLIS ของคุณเอง
TRELLIS_API_KEY=
TRELLIS_ENDPOINT=
